{
  "manifest_version": 3,
  "name": "Doubletake YouTube Playback",
  "version": "1.0.0",
  "description": "Plays requested YouTube videos and unfinished Watch Later items for Doubletake Browser.",
  "permissions": ["nativeMessaging"],
  "host_permissions": ["https://www.youtube.com/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "css": ["player.css"], "run_at": "document_idle"}]
}
